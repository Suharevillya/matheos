{
  "name": "@matheos/cli",
  "version": "0.0.0",
  "description": "Matheos command line: check and render .mth documents.",
  "type": "module",
  "bin": {
    "matheos": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('../skills/matheos-authoring/SKILL.md','SKILL.md')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@matheos/core": "*",
    "@puppeteer/browsers": "^3.2.5",
    "katex": "^0.16.47",
    "puppeteer-core": "^25.14.0"
  },
  "devDependencies": {
    "pdf-parse": "^1.1.1"
  },
  "files": [
    "dist",
    "SKILL.md"
  ]
}
