{
  "name": "@matheos/core",
  "version": "0.0.0",
  "description": "Matheos core: parse -> Document -> evaluate -> Rendered -> HTML. Zero DOM.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "development": "./src/index.ts", "default": "./dist/index.js" },
    "./html": { "types": "./dist/html.d.ts", "development": "./src/html.ts", "default": "./dist/html.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hast-util-to-html": "^9.0.0",
    "katex": "^0.16.11",
    "mathjs": "^15.2.0",
    "mdast-util-to-hast": "^13.2.0",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.0",
    "yaml": "^2.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/katex": "^0.16.7",
    "@types/mdast": "^4.0.4"
  }
}
